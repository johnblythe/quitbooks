# Local dev: embedded Postgres (PGlite), no server needed.
# Neon: set Vercel env DATABASE_URL to the branch's pooled URL (production branch for Production,
# dev branch for Preview). See README "Deploy" for running scripts against Neon without a .env.
DATABASE_URL=pglite:./.pglite

# Direct (non-pooled) Neon URL, used only by `npm run db:migrate`. Leave empty for local PGlite.
DATABASE_URL_UNPOOLED=

# At least 32 random characters. Generate one with: openssl rand -base64 48
# Use a different value for Preview and Production.
SESSION_SECRET=

# Bank sync (SimpleFIN). Encrypts the stored SimpleFIN Access URL: base64 of 32 bytes,
# generate with: openssl rand -base64 32. Do NOT rotate it casually: a new key can't decrypt the
# stored connection, so you'd have to re-link the bank in Settings.
BANK_TOKEN_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/bank-sync.
CRON_SECRET=

# Optional. Claude API key for AI category suggestions in the Inbox. Without it, suggestions are skipped.
ANTHROPIC_API_KEY=
