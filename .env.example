# Local dev: embedded Postgres (PGlite), no server needed.
# Neon: set Vercel env DATABASE_URL to the branch's pooled URL (production branch for Production,
# dev branch for Preview). See README "Deploy" for running scripts against Neon without a .env.
DATABASE_URL=pglite:./.pglite

# Direct (non-pooled) Neon URL, used only by `npm run db:migrate`. Leave empty for local PGlite.
DATABASE_URL_UNPOOLED=

# At least 32 random characters. Generate one with: openssl rand -base64 48
# Use a different value for Preview and Production.
SESSION_SECRET=
