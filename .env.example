# Local dev uses embedded Postgres (PGlite). On Vercel, the Neon integration sets DATABASE_URL.
DATABASE_URL=pglite:./.pglite

# Direct (non-pooled) Neon URL, used for migrations. Leave empty for local PGlite.
DATABASE_URL_UNPOOLED=

# At least 32 random characters. Generate one with: openssl rand -base64 48
# Use a different value for Preview and Production.
SESSION_SECRET=
